<h1>ログイン</h1>

<div class="card">
  <%= form_with scope: :session, url: session_path do |form| %>
    <% if flash[:alert].present? %>
      <div class="flash alert"><%= flash[:alert] %></div>
    <% end %>

    <div class="field">
      <%= form.label :email %>
      <%= form.email_field :email, required: true, autocomplete: "email" %>
    </div>

    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password, required: true, autocomplete: "current-password" %>
    </div>

    <div class="todo-actions">
      <%= form.submit "ログイン", class: "btn" %>
      <%= link_to "サインアップ", new_user_path, class: "btn secondary" %>
    </div>
  <% end %>
</div>
